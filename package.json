{
  "name": "ledger-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Ledger - local-first personal expense tracker for macOS (Next.js renderer + Electron runtime)",
  "author": "Mayank Dhanuka",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "npm --prefix client run dev",
    "dev:electron": "npm run build:electron && LEDGER_DEV=1 electron dist-electron/main/index.js",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "npm --prefix client run build",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json --noEmit && node scripts/build-preload.mjs",
    "start": "electron dist-electron/main/index.js",
    "typecheck": "npm --prefix client run typecheck && npm run typecheck:electron",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "lint": "npm --prefix client run lint",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run build && electron-builder --mac --arm64 --dir",
    "dist": "npm run build && electron-builder --mac --arm64",
    "dist:universal": "npm run build && electron-builder --mac --universal",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^3.24.1"
  },
  "build": {
    "appId": "dev.ledger.desktop",
    "productName": "Ledger",
    "copyright": "Copyright (c) 2026 Mayank Dhanuka",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist-electron/**/*",
      "client/out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "artifactName": "Ledger-${version}-${arch}.${ext}",
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Ledger-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
